# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# BigQuery Configuration
BQ_LOCATION=US
BQ_DATASET_RAW=housing_raw
BQ_DATASET_ANALYTICS=housing_analytics

# Cloud Storage Configuration
GCS_BUCKET_RAW=your-gcp-project-id-housing-raw
GCS_BUCKET_DATA_PATH=raw_data/

# Host path to Application Default Credentials (use forward slashes on Windows)
GOOGLE_APPLICATION_CREDENTIALS_HOST=C:/Users/your-user/AppData/Roaming/gcloud/application_default_credentials.json

# dbt Configuration
DBT_PROFILES_DIR=~/.dbt
DBT_TARGET=dev

# Airflow Configuration
AIRFLOW_HOME=~/airflow
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_PASSWORD=replace-with-a-local-password
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-local-value
